{{define "user-silenced"}}
<div class="alert info">
	<p><strong>Your account has been silenced.</strong> You can still access all of your posts and blogs, but no one else can currently see them.</p>
</div>
{{end}}
{{define "user-unconfirmed"}}
<div class="alert info">
	<p>Please confirm your email address to enable publishing. If you didn't receive an email, you can <a href="/me/confirm">send it again</a> or <a href="/me/settings">update your email address</a>.</p>
</div>
{{end}}
